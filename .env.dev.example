# Copy this file to .env.dev before local development.
# It is sourced by scripts/dev/*.sh, so shell variable expansion is supported.
# Settings are CHEESE_CAVE_<NAME>. An .env.dev written before the rename, with KOHAKU_HUB_<NAME> names,
# still works; when both are set, CHEESE_CAVE_<NAME> wins.

DEV_POSTGRES_USER=hub_dev
DEV_POSTGRES_PASSWORD=hub_dev_password
DEV_POSTGRES_DB=kohakuhub_dev

DEV_MINIO_ROOT_USER=minioadmin
DEV_MINIO_ROOT_PASSWORD=minioadmin

DEV_LAKEFS_ENCRYPT_SECRET_KEY=dev-lakefs-encrypt-key-32chars

# Public links should resolve through the main Vite dev server.
CHEESE_CAVE_BASE_URL=http://127.0.0.1:5173
# Backend self-calls should bypass Vite and hit uvicorn directly.
CHEESE_CAVE_INTERNAL_BASE_URL=http://127.0.0.1:48888
CHEESE_CAVE_API_BASE=/api

CHEESE_CAVE_DB_BACKEND=postgres
CHEESE_CAVE_DATABASE_URL=postgresql://${DEV_POSTGRES_USER}:${DEV_POSTGRES_PASSWORD}@127.0.0.1:25432/${DEV_POSTGRES_DB}
CHEESE_CAVE_DATABASE_KEY=dev-database-key-change-me

CHEESE_CAVE_S3_ENDPOINT=http://127.0.0.1:29001
CHEESE_CAVE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:29001
CHEESE_CAVE_S3_ACCESS_KEY=${DEV_MINIO_ROOT_USER}
CHEESE_CAVE_S3_SECRET_KEY=${DEV_MINIO_ROOT_PASSWORD}
CHEESE_CAVE_S3_BUCKET=hub-storage
CHEESE_CAVE_S3_REGION=us-east-1

CHEESE_CAVE_LAKEFS_ENDPOINT=http://127.0.0.1:28000
CHEESE_CAVE_LAKEFS_REPO_NAMESPACE=hf

# L2 cache (Valkey). Default-on in dev so contributors hit cache bugs early.
# See docs/development/cache.md for the design. Disable with =false to
# verify the silent-degradation contract locally.
CHEESE_CAVE_CACHE_ENABLED=true
CHEESE_CAVE_CACHE_URL=redis://127.0.0.1:26379/0

CHEESE_CAVE_SESSION_SECRET=dev-session-secret-change-me
CHEESE_CAVE_SESSION_EXPIRE_HOURS=720
CHEESE_CAVE_SESSION_ABSOLUTE_DAYS=365
CHEESE_CAVE_TOKEN_EXPIRE_DAYS=365
CHEESE_CAVE_REQUIRE_EMAIL_VERIFICATION=false
CHEESE_CAVE_INVITATION_ONLY=false

CHEESE_CAVE_ADMIN_ENABLED=true
CHEESE_CAVE_ADMIN_SECRET_TOKEN=dev-admin-token-change-me
# The dev token above is short on purpose; production needs a long random one (the admin API refuses a weak token).
CHEESE_CAVE_ADMIN_ALLOW_WEAK_TOKEN=true
# First backend bootstrap can auto-create fixed local demo users/orgs/repos.
CHEESE_CAVE_DEV_AUTO_SEED=true

CHEESE_CAVE_SITE_NAME="CheeseCave Dev"
CHEESE_CAVE_LOG_LEVEL=INFO
CHEESE_CAVE_LOG_FORMAT=terminal
CHEESE_CAVE_LFS_THRESHOLD_BYTES=1000000
CHEESE_CAVE_LFS_MULTIPART_THRESHOLD_BYTES=100000000
CHEESE_CAVE_LFS_MULTIPART_CHUNK_SIZE_BYTES=50000000
CHEESE_CAVE_LFS_KEEP_VERSIONS=5
CHEESE_CAVE_LFS_AUTO_GC=true
