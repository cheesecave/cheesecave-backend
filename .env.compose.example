# Copy to ignored .env, or run python scripts/generate_docker_compose.py --generate-config.
# These LOCAL image names work with compose.build.yml. Published releases may use
# complete repository:tag or repository@sha256:digest references independently.
CHEESECAVE_BACKEND_IMAGE=cheesecave-backend:local
CHEESECAVE_WEB_IMAGE=cheesecave-web:local
CHEESECAVE_ADMIN_IMAGE=cheesecave-admin:local
CHEESECAVE_HTTP_PORT=28080
CHEESECAVE_NETWORK_NAME=cheesecave-net
POSTGRES_USER=hub
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=CHANGE_ME
KOHAKU_HUB_SESSION_SECRET=CHANGE_ME
KOHAKU_HUB_ADMIN_SECRET_TOKEN=CHANGE_ME
KOHAKU_HUB_DATABASE_KEY=CHANGE_ME
KOHAKU_HUB_SITE_NAME=CheeseCave
KOHAKU_HUB_BASE_URL=http://127.0.0.1:28080
KOHAKU_HUB_S3_PUBLIC_ENDPOINT=http://127.0.0.1:29001
# UID/GID own the bind-mounted LakeFS and Valkey directories on Linux.
UID=1000
GID=1000

# Optional source-build identity (each checkout has its own commit):
# KOHAKU_HUB_GIT_SHA=
# KOHAKU_HUB_BUILD_TIME=
# CHEESECAVE_WEB_GIT_SHA=
# CHEESECAVE_WEB_GIT_DIRTY=false
# CHEESECAVE_ADMIN_GIT_SHA=
# CHEESECAVE_ADMIN_GIT_DIRTY=false
