# Copy to ignored .env, or run python scripts/generate_docker_compose.py --generate-config.
# Settings are CHEESE_CAVE_<NAME>. A .env written before the rename, with KOHAKU_HUB_<NAME> keys,
# still works; when both are set, CHEESE_CAVE_<NAME> wins.
# Default: docker compose pulls ghcr.io/cheesecave/cheesecave-{backend,web,admin}:latest.
# Pin a release, or override any single image (repository:tag or @sha256:digest):
# CHEESECAVE_VERSION=latest
# CHEESECAVE_BACKEND_IMAGE=
# CHEESECAVE_WEB_IMAGE=
# CHEESECAVE_ADMIN_IMAGE=
CHEESECAVE_HTTP_PORT=28080
CHEESECAVE_NETWORK_NAME=cheesecave-net
POSTGRES_USER=hub
POSTGRES_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=CHANGE_ME
CHEESE_CAVE_SESSION_SECRET=CHANGE_ME
CHEESE_CAVE_ADMIN_SECRET_TOKEN=CHANGE_ME
CHEESE_CAVE_DATABASE_KEY=CHANGE_ME
CHEESE_CAVE_SITE_NAME=CheeseCave
CHEESE_CAVE_BASE_URL=http://127.0.0.1:28080
CHEESE_CAVE_S3_PUBLIC_ENDPOINT=http://127.0.0.1:29001
# UID/GID own the bind-mounted LakeFS and Valkey directories on Linux.
UID=1000
GID=1000

# Optional source-build identity (each checkout has its own commit):
# CHEESE_CAVE_GIT_SHA=
# CHEESE_CAVE_BUILD_TIME=
# CHEESECAVE_WEB_GIT_SHA=
# CHEESECAVE_WEB_GIT_DIRTY=false
# CHEESECAVE_ADMIN_GIT_SHA=
# CHEESECAVE_ADMIN_GIT_DIRTY=false
