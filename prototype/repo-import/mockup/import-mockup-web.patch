+          <details><summary class="cursor-pointer text-sm font-semibold">Log</summary>
+            <pre class="text-xs bg-gray-50 dark:bg-gray-800 rounded p-2 overflow-x-auto" data-testid="log">{{ job.log.join("\n") }}</pre></details>
+        </div>
+      </template>
+
+      <!-- ======================================================== form + preview -->
+      <template v-else>
+        <div class="card p-4 space-y-4" data-testid="form">
+          <div class="grid sm:grid-cols-[1fr_140px_1.5fr_120px] gap-3">
+            <label class="text-sm">Source
+              <el-select v-model="form.source" data-testid="source" class="w-full"><el-option v-for="s in sources" :key="s" :label="s" :value="s" /></el-select></label>
+            <label class="text-sm">Type
+              <el-select v-model="form.type" class="w-full"><el-option v-for="t in ['model','dataset','space']" :key="t" :value="t" :label="t" /></el-select></label>
+            <label class="text-sm">Repository on the source
+              <el-input v-model="form.repo" data-testid="repo" placeholder="owner/name" /></label>
+            <label class="text-sm">Revision
+              <el-input v-model="form.revision" placeholder="main" /></label>
+          </div>
+          <div class="grid sm:grid-cols-[1fr_1fr_120px] gap-3">
+            <label class="text-sm">Into namespace<el-select v-model="form.ns" class="w-full"><el-option v-for="n in ['narugo1992','deepghs']" :key="n" :value="n" :label="n" /></el-select></label>
+            <label class="text-sm">As<el-input v-model="form.name" placeholder="same name" /></label>
+            <label class="text-sm">Visibility<el-select v-model="form.visibility" class="w-full"><el-option value="private" label="private" /><el-option value="public" label="public" /></el-select></label>
+          </div>
+          <div>
+            <div class="text-sm mb-1">Files to copy <span class="text-gray-500">(like <code>allow_patterns</code> / <code>ignore_patterns</code> of <code>snapshot_download</code>)</span></div>
+            <div class="grid sm:grid-cols-2 gap-3">
+              <el-input v-model="form.allow" type="textarea" :rows="2" placeholder="allow: *.json, *.safetensors" data-testid="allow" />
+              <el-input v-model="form.ignore" type="textarea" :rows="2" placeholder="ignore: *.onnx, *.tflite, *.h5" data-testid="ignore" />
+            </div>
+            <div class="flex flex-wrap gap-2 mt-2 text-xs">
+              <el-tag v-for="p in PRESETS" :key="p.label" class="cursor-pointer" effect="plain" @click="Object.assign(form, p.set)">{{ p.label }}</el-tag>
+            </div>
+          </div>
+          <div class="flex items-center gap-3">
+            <el-button type="primary" data-testid="preview-btn" :loading="busy" @click="previewNow">Preview</el-button>
+            <span class="text-xs text-gray-500">Nothing is copied until you press Start. The preview only lists the source.</span>
