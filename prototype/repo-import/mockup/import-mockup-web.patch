+</template>
+
+<script setup>
+import { computed, onBeforeUnmount, onMounted, reactive, ref } from "vue";
+import { useRoute } from "vue-router";
+import api from "@/utils/api";
+
+const route = useRoute();
+const STAGES = ["Queued", "Listing", "Transferring", "Verifying", "Committing", "Done"];
+const PRESETS = [
+  { label: "weights as safetensors only", set: { allow: "*.json, *.txt, *.safetensors", ignore: "" } },
+  { label: "skip onnx / tflite / h5", set: { allow: "", ignore: "*.onnx, *.tflite, *.h5, *.msgpack, *.ot" } },
+  { label: "docs and config only", set: { allow: "*.md, *.json, *.txt", ignore: "" } },
+];
+const sources = ["HuggingFace", "ModelScope mirror (HF-compatible)", "Internal Artifactory"];
+const form = reactive({ source: "HuggingFace", type: route.query.type || "model", repo: route.query.repo || "", revision: "main", ns: "narugo1992", name: "", visibility: "private", allow: "", ignore: "" });
+const preview = ref(null);
+const error = ref("");
+const busy = ref(false);
+const job = ref(null);
+let timer = null;
+
+const over = computed(() => preview.value && preview.value.quota.used + preview.value.totals.new_bytes > preview.value.quota.limit);
+const pct = computed(() => (job.value && job.value.bytes_total ? Math.round((job.value.bytes_done / job.value.bytes_total) * 100) : 0));
+const tagType = computed(() => ({ succeeded: "success", failed: "danger", running: "warning", queued: "info" }[job.value?.status] || "info"));
+const stageIndex = computed(() => (job.value?.status === "succeeded" ? STAGES.length : STAGES.indexOf(job.value?.stage)));
+const fmt = (n) => (n < 1e6 ? `${(n / 1e3).toFixed(0)} kB` : n < 1e9 ? `${(n / 1e6).toFixed(1)} MB` : `${(n / 1e9).toFixed(2)} GB`);
+
+async function previewNow() {
+  busy.value = true;
+  error.value = "";
+  try {
+    preview.value = (await api.post("/api/repos/import/preview", { ...form })).data;
+  } catch (e) {
+    preview.value = null;
+    error.value = e.response?.data?.detail?.error || e.message;
+  } finally {
+    busy.value = false;
+  }
+}
+
+async function poll() {
+  job.value = (await api.get(`/api/repos/import/${route.query.id}`)).data;
+  if (["succeeded", "failed", "cancelled"].includes(job.value.status)) clearInterval(timer);
+}
+onMounted(async () => {
+  if (route.query.id) {
+    await poll();
+    timer = setInterval(poll, 2000);
+  } else if (route.query.repo && route.query.preview) {
+    await previewNow();
+  }
+});
+onBeforeUnmount(() => clearInterval(timer));
+</script>
