+
+        <el-alert v-if="error" :title="error" type="error" show-icon :closable="false" data-testid="form-error" />
+
+        <div v-if="preview" class="card p-4 space-y-3" data-testid="preview">
+          <div class="flex flex-wrap items-center gap-2">
+            <h2 class="text-lg font-semibold">Preview</h2>
+            <el-tag type="info">source commit <code>{{ preview.source_sha.slice(0, 8) }}</code></el-tag>
+            <el-tag v-for="w in preview.warnings" :key="w" type="warning">{{ w }}</el-tag>
+          </div>
+          <div class="grid sm:grid-cols-4 gap-3 text-sm">
+            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3"><div class="text-xs text-gray-500">Files</div><b class="text-xl" data-testid="t-files">{{ preview.totals.files }}</b></div>
+            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3"><div class="text-xs text-gray-500">Selected size</div><b class="text-xl">{{ fmt(preview.totals.bytes) }}</b></div>
+            <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-3"><div class="text-xs text-gray-500">Already stored here</div><b class="text-xl text-green-700" data-testid="t-saved">{{ fmt(preview.totals.deduped_bytes) }}</b></div>
+            <div class="border border-amber-300 rounded-lg p-3"><div class="text-xs text-gray-500">New bytes (counts against quota)</div><b class="text-xl" data-testid="t-new">{{ fmt(preview.totals.new_bytes) }}</b></div>
+          </div>
+          <div>
+            <div class="flex justify-between text-xs mb-1"><span>Quota of {{ form.ns }}</span><span data-testid="quota">{{ fmt(preview.quota.used) }} used + {{ fmt(preview.totals.new_bytes) }} new of {{ fmt(preview.quota.limit) }}</span></div>
+            <el-progress :percentage="Math.min(100, Math.round(((preview.quota.used + preview.totals.new_bytes) / preview.quota.limit) * 100))" :status="over ? 'exception' : ''" :stroke-width="12" />
+          </div>
+          <el-alert v-if="over" type="error" show-icon :closable="false" data-testid="over-quota"
+            title="This import would exceed the quota" description="Narrow the file filter, or ask an administrator to raise the quota. Nothing was copied." />
+          <table class="w-full text-sm" data-testid="preview-files">
+            <thead class="bg-gray-50 dark:bg-gray-800 text-left"><tr><th class="px-3 py-1.5">File</th><th class="px-3 py-1.5 w-28">Size</th><th class="px-3 py-1.5 w-24">Kind</th><th class="px-3 py-1.5 w-44">Will be</th></tr></thead>
+            <tbody>
+              <tr v-for="f in preview.files" :key="f.path" class="border-t border-gray-100 dark:border-gray-800">
+                <td class="px-3 py-1.5 font-mono text-xs">{{ f.path }}</td><td class="px-3 py-1.5">{{ fmt(f.size) }}</td>
+                <td class="px-3 py-1.5">{{ f.lfs ? "LFS" : "regular" }}</td>
+                <td class="px-3 py-1.5"><el-tag size="small" :type="f.present ? 'info' : 'success'">{{ f.present ? "skipped (already stored)" : "transferred" }}</el-tag></td>
+              </tr>
+            </tbody>
+          </table>
+          <div class="text-xs text-gray-500">… and {{ preview.totals.files - preview.files.length }} more files</div>
+          <div class="flex items-center gap-3">
+            <el-button type="primary" :disabled="over" data-testid="start-btn">Start import</el-button>
+            <span class="text-xs text-gray-500">Runs in the background; you can close this page. The repository appears when everything is verified, in one commit that records where it came from.</span>
