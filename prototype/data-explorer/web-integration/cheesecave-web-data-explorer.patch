+async function load() {
+  const route = mode.value === "rows" ? "rows" : mode.value;
+  const params = { config: config.value, split: split.value, offset: offset.value, length: LENGTH };
+  if (mode.value === "filter") params.where = term.value;
+  if (mode.value === "search") params.query = term.value;
+  const t0 = performance.now();
+  const j = await guard(() => viewer(repo.value, route, params, { rows: "rows page", filter: "filter scan", search: "search scan" }[route]));
+  if (!j) return;
+  page.value = j;
+  pageMs.value = Math.round(performance.now() - t0);
+  Object.keys(thumbs).forEach((k) => delete thumbs[k]);
+  fillThumbs(j);
+}
+
+async function loadStats() {
+  stats.value = null;
+  stats.value = await guard(() => viewer(repo.value, "statistics", { config: config.value, split: split.value }, "statistics"));
+}
+
+// Image cells are descriptors; the bytes come from storage with Range reads, not through the hub.
+async function fillThumbs(j) {
+  const col = j.features.find((f) => j.rows[0]?.row[f.name]?._type === "binary-struct")?.name;
+  if (!col || !currentSplit.value) return;
+  const { file, local } = await fileOfRow(repo.value, currentSplit.value.files, j.rows[0].row_idx);
+  const { rows } = await readParquetRows(repo.value, file, local, local + j.rows.length, [col], { utf8: false, label: "image column (visible rows)" });
+  rows.forEach((r, i) => { const b = r[col]?.bytes; if (b) thumbs[j.rows[i].row_idx] = URL.createObjectURL(new Blob([b])); });
+}
+
+// ---- SQL
+const sql = ref("");
+const budgetMiB = ref(64);
+const sqlBusy = ref(false);
+const sqlOut = ref(null);
+watch(split, (s) => { if (s && !sql.value) sql.value = `SELECT label, count(*) AS n, round(avg(score), 3) AS avg_score\nFROM ${s}\nGROUP BY label ORDER BY label`; }, { immediate: true });
+
+async function runQuery() {
+  sqlBusy.value = true;
+  sqlOut.value = null;
+  await guard(async () => {
+    const target = footerCountTarget(sql.value);
+    if (target) {
+      const size = await viewer(repo.value, "size", { config: config.value }, "exact row count from footers");
+      sqlOut.value = { footer: true, columns: ["count_star()"], rows: [[size.splits.find((s) => s.split === target).num_rows]], infos: {}, note: "No SQL engine was loaded and no data bytes were read." };
+      return;
+    }
+    const r = await runSql(repo.value, resolution.value, config.value, sql.value, budgetMiB.value * 1048576);
+    sqlOut.value = { ...r, approximate: Object.values(r.infos).some((i) => i.approximate), note: `${r.rows.length} row(s) · query ${r.ms} ms` };
+  });
+  sqlBusy.value = false;
+}
+
+// ---- Archives
+const tarPath = ref("");
+const tar = ref(null);
+const memberThumb = reactive({});
+const memberText = reactive({});
+// The file list arrives after the splits, so both the view and the list can be what completes the condition.
+watch([view, tarFiles], ([v]) => {
+  if (v === "archive" && !tar.value && tarFiles.value.length) {
+    tarPath.value = (tarFiles.value.find((f) => f.path.includes("shard-")) || tarFiles.value[0]).path;
+    loadTar();
+  }
+});
+watch([view, files], ([v]) => { if (v === "compare") initCompare(); });
+async function loadTar() {
+  tar.value = null;
+  const j = await guard(() => viewer(repo.value, "tar-index", { path: tarPath.value, limit: 12 }, "tar header walk"));
+  if (!j) return;
+  tar.value = j;
+  for (const s of j.samples) {
+    const img = s.members.find((m) => /^(jpe?g|png|webp)$/.test(m.ext));
+    const txt = s.members.find((m) => m.ext === "txt" || m.ext === "json");
+    if (img) readRange(repo.value, tarPath.value, img.offset, img.offset + img.size, "member image").then((b) => { memberThumb[s.key] = URL.createObjectURL(new Blob([b])); });
+    if (txt) readRange(repo.value, tarPath.value, txt.offset, txt.offset + txt.size, "member caption").then((b) => { memberText[s.key] = new TextDecoder().decode(b).slice(0, 110); });
+  }
+}
+
+// ---- Compare
+const commitList = ref([]);
+const diffPath = ref("");
+const oldRev = ref("");
+const newRev = ref("");
+const diffKey = ref("id");
+const diff = ref(null);
+async function initCompare() {
+  if (commitList.value.length || !files.value.length) return;
+  commitList.value = (await guard(() => commits(repo.value))) || [];
+  newRev.value = commitList.value[0]?.id || "";
+  oldRev.value = commitList.value.at(-2)?.id || commitList.value.at(-1)?.id || "";
+  diffPath.value = parquetFiles.value[0]?.path || "";
+}
+async function runDiff() {
+  diff.value = await guard(() => viewer(repo.value, "diff", { path: diffPath.value, old: oldRev.value, new: newRev.value, ...(diffKey.value ? { key: diffKey.value } : {}) }, "diff two commits"));
+}
+
+onMounted(init);
+watch(() => [props.namespace, props.name, props.branch], init);
+</script>
