+<!-- First rows of the default split, shown on the dataset card. One API call; links to the Data tab. -->
+<template>
+  <div v-if="page" class="card p-4 mb-4" data-testid="preview-card">
+    <div class="flex items-center gap-2 mb-2">
+      <span class="i-carbon-table text-amber-700" />
+      <h3 class="font-semibold">Dataset preview</h3>
+      <el-tag size="small" type="info">{{ splitName }} · {{ page.num_rows_total?.toLocaleString() ?? "?" }} rows</el-tag>
+      <span class="flex-1" />
+      <a class="text-sm text-blue-600 dark:text-blue-400 cursor-pointer" data-testid="viewall" @click="$emit('open-data')">View all rows →</a>
+    </div>
+    <div class="overflow-x-auto">
+      <table class="w-full text-sm">
+        <thead class="bg-gray-50 dark:bg-gray-800">
+          <tr><th v-for="f in page.features" :key="f.name" class="text-left px-3 py-1.5 font-semibold">{{ f.name }}</th></tr>
+        </thead>
+        <tbody>
+          <tr v-for="r in page.rows" :key="r.row_idx" class="border-t border-gray-100 dark:border-gray-800">
+            <td v-for="f in page.features" :key="f.name" class="px-3 py-1.5 max-w-[320px] truncate">
+              <span v-if="r.row[f.name] && r.row[f.name]._type === 'binary-struct'" class="text-gray-400">image</span>
+              <span v-else-if="r.row[f.name] == null" class="italic text-gray-400">null</span>
+              <span v-else-if="typeof r.row[f.name] === 'object'" class="font-mono text-xs">{{ JSON.stringify(r.row[f.name]) }}</span>
+              <span v-else>{{ f.type._type === "ClassLabel" ? f.type.names[r.row[f.name]] : r.row[f.name] }}</span>
+            </td>
+          </tr>
+        </tbody>
+      </table>
+    </div>
+  </div>
+</template>
+
+<script setup>
+import { onMounted, ref } from "vue";
+import { viewer } from "@/utils/explorer";
+
+const props = defineProps({ repoType: String, namespace: String, name: String, branch: { type: String, default: "main" } });
+defineEmits(["open-data"]);
+const page = ref(null);
+const splitName = ref("");
+
+onMounted(async () => {
+  const repo = { type: props.repoType, ns: props.namespace, name: props.name, revision: props.branch || "main" };
+  try {
+    const res = await viewer(repo, "splits");
+    const cfg = res.configs.find((c) => c.default) || res.configs[0];
+    splitName.value = cfg.splits[0].split;
+    page.value = await viewer(repo, "rows", { config: cfg.config, split: splitName.value, offset: 0, length: 4 });
+  } catch {
+    page.value = null; // no tabular data in this dataset: show nothing
+  }
+});
+</script>
