diff -ruN -x node_modules -x '*.d.ts' -x '.eslintrc*' web-base/src/utils/explorer.js web/src/utils/explorer.js
--- a/src/utils/explorer.js	1970-01-01 08:00:00.000000000 +0800
+++ b/src/utils/explorer.js	2026-10-19 11:01:54.315398409 +0800
@@ -0,0 +1,159 @@
+// src/utils/explorer.js
+// Data Explorer client: the viewer API (L2) plus the browser readers (L1) and browser SQL (L4).
+// Every call is recorded in `flow` so the UI can show what happened and what it cost.
+import { reactive } from "vue";
+import { parquetMetadataAsync, parquetReadObjects } from "hyparquet";
+import api from "@/utils/api";
+
+export const flow = reactive({ steps: [] });
+const note = (step) => {
+  flow.steps.push(step);
+  return step;
+};
+export const clearFlow = () => flow.steps.splice(0);
+
+const authHeaders = () => {
+  const token = localStorage.getItem("hf_token");
+  return token ? { Authorization: `Bearer ${token}` } : {};
+};
+
+export class ExplorerError extends Error {
+  constructor(status, code, detail) {
+    super(detail);
+    Object.assign(this, { status, code });
+  }
+}
+
+// ---- L2: the bounded server API --------------------------------------------------------------------------------
+export async function viewer(repo, route, params = {}, label = route) {
+  const step = note({ who: "hub", label, url: `viewer/${route}`, status: 0, ms: 0, bytes: 0 });
+  const t0 = performance.now();
+  try {
+    const r = await api.get(`/api/${repo.type}s/${repo.ns}/${repo.name}/viewer/${route}`, {
+      params: { revision: repo.revision, ...params },
+      transformResponse: (d) => d,
+    });
+    step.status = r.status;
+    step.bytes = new Blob([r.data]).size;
+    return JSON.parse(r.data);
+  } catch (e) {
+    step.status = e.response?.status || 0;
+    const body = (() => { try { return JSON.parse(e.response?.data); } catch { return {}; } })();
+    throw new ExplorerError(step.status, e.response?.headers?.["x-error-code"] || "", body.detail?.error || body.error || e.message);
+  } finally {
+    step.ms = Math.round(performance.now() - t0);
+  }
+}
+
+export async function treeFiles(repo) {
+  const step = note({ who: "hub", label: "list files", url: "tree", status: 0, ms: 0, bytes: 0 });
+  const t0 = performance.now();
+  const r = await api.get(`/api/${repo.type}s/${repo.ns}/${repo.name}/tree/${repo.revision}`, { params: { recursive: true } });
+  step.status = r.status;
+  step.ms = Math.round(performance.now() - t0);
+  return r.data.filter((e) => e.type === "file");
+}
+
+export async function commits(repo) {
+  const r = await api.get(`/api/${repo.type}s/${repo.ns}/${repo.name}/commits/${repo.revision}`);
+  return r.data.map((c) => ({ id: c.id, title: c.title }));
+}
+
+// ---- L1: Range reads straight from storage ---------------------------------------------------------------------
+export const resolveUrl = (repo, path, rev = repo.revision) => `/${repo.type}s/${repo.ns}/${repo.name}/resolve/${rev}/${path}`;
+
+export async function readRange(repo, path, start, endExclusive, label = "range read") {
+  const step = note({ who: "storage", label, url: path, range: `bytes=${start}-${endExclusive - 1}`, status: 0, ms: 0, bytes: 0 });
+  const t0 = performance.now();
+  try {
+    const r = await fetch(resolveUrl(repo, path), { headers: { Range: `bytes=${start}-${endExclusive - 1}`, ...authHeaders() } });
+    step.status = r.status;
+    const buf = await r.arrayBuffer();
+    step.bytes = buf.byteLength;
+    return r.status === 200 ? buf.slice(start, endExclusive) : buf;
+  } finally {
+    step.ms = Math.round(performance.now() - t0);
+  }
+}
+
+const asyncBuffer = (repo, file, label) => ({ byteLength: file.size, slice: (a, b = file.size) => readRange(repo, file.path, a, Math.min(b, file.size), label) });
+
+let compressorsPromise;
+const compressors = () => (compressorsPromise ||= import(/* @vite-ignore */ "https://esm.sh/hyparquet-compressors@1.1.2").then((m) => m.compressors).catch(() => undefined));
+
+const metaCache = new Map();
+export async function parquetMeta(repo, file, label = "parquet footer") {
+  const key = `${repo.ns}/${repo.name}@${repo.revision}/${file.path}`;
+  if (!metaCache.has(key)) metaCache.set(key, await parquetMetadataAsync(asyncBuffer(repo, file, label)));
+  return metaCache.get(key);
+}
+
+export async function readParquetRows(repo, file, rowStart, rowEnd, columns, { utf8 = true, label = "parquet" } = {}) {
+  const metadata = await parquetMeta(repo, file);
+  return { metadata, rows: await parquetReadObjects({ file: asyncBuffer(repo, file, label), metadata, rowStart, rowEnd, columns, utf8, compressors: await compressors() }) };
+}
+
+export async function fileOfRow(repo, files, index) {
+  let before = 0;
+  for (const f of files) {
+    const n = Number((await parquetMeta(repo, f)).num_rows);
+    if (index < before + n) return { file: f, local: index - before };
+    before += n;
+  }
+  throw new Error("row is past the end of the split");
+}
+
+// ---- L4: browser SQL -------------------------------------------------------------------------------------------
+let duckPromise;
+export function duckdb() {
+  duckPromise ||= (async () => {
+    const lib = await import(/* @vite-ignore */ "https://cdn.jsdelivr.net/npm/@duckdb/duckdb-wasm@1.32.0/+esm");
+    const bundle = await lib.selectBundle(lib.getJsDelivrBundles());
+    const worker = new Worker(URL.createObjectURL(new Blob([`importScripts("${bundle.mainWorker}");`], { type: "text/javascript" })));
+    const db = new lib.AsyncDuckDB(new lib.ConsoleLogger(lib.LogLevel.WARNING), worker);
+    await db.instantiate(bundle.mainModule, bundle.pthreadWorker);
+    return db;
+  })();
+  return duckPromise;
+}
+
+// "select count(*) from <split>" is answered from the footers: exact, zero data bytes, no engine.
+export const footerCountTarget = (sql) => sql.match(/^\s*select\s+count\(\*\)\s+(?:as\s+\w+\s+)?from\s+"?([\w-]+)"?\s*;?\s*$/i)?.[1] ?? null;
+
+const loaded = new Map();
+export async function runSql(repo, resolution, config, sql, budgetBytes) {
+  const db = await duckdb();
+  const conn = await db.connect();
+  try {
+    const infos = {};
+    for (const s of resolution.configs.find((c) => c.config === config).splits) {
+      if (!new RegExp(`\\b${s.split}\\b`).test(sql)) continue;
+      const key = `${repo.ns}/${repo.name}@${repo.revision}/${config}/${s.split}`;
+      if (!loaded.has(key)) {
+        let used = 0;
+        const names = [];
+        for (const [i, f] of s.files.entries()) {
+          if (used + f.size > budgetBytes && names.length) break;
+          if (used + f.size > budgetBytes) throw new Error(`${s.split}: the first file alone is ${f.size} bytes, over the browser budget of ${budgetBytes}`);
+          const name = `${s.split}-${i}.${s.format === "jsonl" ? "json" : s.format}`;
+          await db.registerFileBuffer(name, new Uint8Array(await readRange(repo, f.path, 0, f.size, `load ${s.split} into SQL`)));
+          names.push(name);
+          used += f.size;
+        }
+        const reader = { parquet: "read_parquet", csv: "read_csv_auto", jsonl: "read_json_auto" }[s.format];
+        await conn.query(`CREATE OR REPLACE VIEW "${s.split}" AS SELECT * FROM ${reader}([${names.map((n) => `'${n}'`).join(",")}])`);
+        loaded.set(key, { approximate: names.length < s.files.length, loadedFiles: names.length, totalFiles: s.files.length, bytes: used });
+      }
+      infos[s.split] = loaded.get(key);
+    }
+    const t0 = performance.now();
+    const result = await conn.query(sql);
+    const columns = result.schema.fields.map((f) => f.name);
+    const rows = result.toArray().map((r) => columns.map((c) => (typeof r[c] === "bigint" ? Number(r[c]) : r[c])));
+    return { columns, rows, infos, ms: Math.round(performance.now() - t0) };
+  } finally {
+    await conn.close();
+  }
+}
+
+export const fmtBytes = (n) => (n < 1024 ? `${n} B` : n < 1048576 ? `${(n / 1024).toFixed(1)} KiB` : `${(n / 1048576).toFixed(1)} MiB`);
