[run]
source = kohakuhub
# Slices run on different runners and are added up in one job (backend-gate).
relative_files = True
omit =
    */test/*
    */tests/*
    */migrations/*
    */__pycache__/*
    */venv/*
    */virtualenv/*
    */src/kohakuhub/old_db.py
    */src/kohakuhub/old_logger.py

[report]
precision = 2
show_missing = True
skip_covered = False
fail_under = 50

[html]
directory = htmlcov
